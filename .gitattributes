# Force GitHub Linguist to detect repository programming languages accurately
*.js linguist-detectable=true linguist-language=JavaScript
public/js/*.js linguist-detectable=true linguist-language=JavaScript
public/css/*.css linguist-detectable=true linguist-language=CSS
public/*.html linguist-detectable=true linguist-language=HTML
render.yaml linguist-detectable=true linguist-language=YAML
Dockerfile linguist-detectable=true linguist-language=Dockerfile

# Exclude generated data and lockfiles from skewing language calculations
data/*.json linguist-documentation
package-lock.json linguist-generated
